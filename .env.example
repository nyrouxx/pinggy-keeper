# Tunnel access token from the Pinggy dashboard.
PINGGY_TOKEN=
# Use pro.pinggy.io if your Pinggy dashboard gives you that server.
PINGGY_SERVER=free.pinggy.io

# Token from the FreeDNS v2 update URL for your AAAA record.
FREEDNS_TOKEN=

# Local UDP port on 127.0.0.1 of the Docker host.
WIREGUARD_PORT=51820

POLL_INTERVAL_SECONDS=10
